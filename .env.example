# WebSocket Server Configuration — copy to .env and adjust

# Stack identity (for Multi-Instance on the same Docker host)
# Each stack on the same host needs a unique STACK_NAME + EXTERNAL_PORT.
STACK_NAME=framework-ws
EXTERNAL_PORT=3001

# Server (internal — WS_PORT stays 3001, external is published via EXTERNAL_PORT)
WS_HOST=0.0.0.0

# CORS — Browser-Origins die per WS connecten dürfen.
# Single-site:  CORS_ORIGIN=https://your-framework.example.com
# Multi-site:   CORS_ORIGIN=https://site-a.example.com,https://site-b.example.com
# Wildcard "*" nur für lokale Entwicklung verwenden.
CORS_ORIGIN=https://your-framework.example.com

# Database (MySQL) — optional, nur wenn der WS-Server direkt DB-Notifications lesen soll
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=framework
DB_PREFIX=fw_

# PHP API — Framework-URL für Token-Validierung
API_URL=https://your-framework.example.com/framework

# Internal Secret — wird mit dem Framework gemeinsam genutzt.
# Wert kommt aus: Framework → Einstellungen → System → WebSocket → "Internal Secret"
# Leer lassen für legacy Loopback-Auth (nur wenn WS-Container und Framework
# auf demselben Host laufen).
WS_INTERNAL_SECRET=

# Logging
LOG_LEVEL=info
